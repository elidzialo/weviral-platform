# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Stripe
STRIPE_SECRET_KEY=sk_live_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# OpenAI
OPENAI_API_KEY=sk-...

# Resend (transactional email — bypasses Supabase email rate limits)
RESEND_API_KEY=re_...

# App
NEXT_PUBLIC_APP_URL=https://weviral.co.uk

# Amazon Ads agent (https://advertising.amazon.com/API/docs/en-us/guides/onboarding/overview)
# Login with Amazon security profile approved for the Amazon Ads API.
# Allowed return URL: {NEXT_PUBLIC_APP_URL}/api/amazon-ads/callback
AMAZON_ADS_CLIENT_ID=amzn1.application-oa2-client....
AMAZON_ADS_CLIENT_SECRET=...
# Shared secret Vercel Cron sends as "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=...
